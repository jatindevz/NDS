{
  "name": "nds",
  "version": "0.1.0",
  "private": true,
  "description": "Job queue and notification delivery service",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "worker": "tsx src/worker/index.ts",
    "api": "tsx src/api/index.ts",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "bullmq": "^6.2.0",
    "eslint": "^10.9.0",
    "express": "^5.2.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "redis-memory-server": "^0.17.1",
    "supertest": "^7.3.0"
  }
}
