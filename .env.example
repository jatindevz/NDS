# Copy to .env and fill in. .env is gitignored.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
REDIS_URL=redis://:nds_dev_password@localhost:6379
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nds
RESEND_API_KEY=
# From-address for outbound email (required for the email handler to deliver)
EMAIL_FROM=
# Static bearer token guarding the API (min 16 chars; unset = API rejects all requests)
API_KEY=
# Webhook delivery timeout in ms
WEBHOOK_TIMEOUT_MS=10000
WORKER_CONCURRENCY=5
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
